# Copy this file to .env before starting the stack.
APP_PORT=8080

POSTGRES_DB=naghshegard
POSTGRES_USER=naghshegard
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Use a long, random value (at least 64 characters) in production.
JWT_SECRET=replace-with-a-long-random-jwt-secret-at-least-64-characters
JWT_EXPIRATION=864000000

# Gmail requires an App Password when two-step verification is enabled.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
THYMELEAF_CACHE=true
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
